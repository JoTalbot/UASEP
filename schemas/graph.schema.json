{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/UASEP/schemas/graph.schema.json",
  "title": "UASEP Task Graph",
  "type": "object",
  "required": ["protocol", "protocol_version", "tasks"],
  "properties": {
    "protocol": {"const": "UASEP"},
    "protocol_version": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {"$ref": "task.schema.json"}
    }
  },
  "additionalProperties": true
}
