{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/UASEP/schemas/manifest.schema.json",
  "title": "UASEP Project Manifest",
  "type": "object",
  "required": ["protocol", "protocol_version", "project_state", "autonomy_level"],
  "properties": {
    "protocol": {"const": "UASEP"},
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project_instance": {"type": "string"},
    "project_state": {"enum": ["initializing", "active", "paused", "blocked", "handoff", "recovering", "complete", "maintenance"]},
    "autonomy_level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7"]},
    "source_of_truth": {"type": "string"},
    "local_state": {"type": "string"}
  },
  "additionalProperties": true
}
