{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/UASEP/schemas/task.schema.json",
  "title": "UASEP Task",
  "type": "object",
  "required": ["id", "objective", "status", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string"},
    "objective": {"type": "string"},
    "status": {"enum": ["queued", "ready", "running", "blocked", "failed", "review", "verified", "complete", "cancelled"]},
    "priority": {"type": "number"},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "owner": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "write_set": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Paths or resources this task may write; used for parallel conflict detection"
    }
  },
  "additionalProperties": true
}
