{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/UASEP/schemas/state.schema.json",
  "title": "UASEP State",
  "type": "object",
  "required": ["protocol", "protocol_version", "project_id", "phase"],
  "properties": {
    "protocol": {"const": "UASEP"},
    "protocol_version": {"type": "string"},
    "project_id": {"type": "string"},
    "phase": {
      "enum": [
        "initializing",
        "active",
        "paused",
        "blocked",
        "handoff",
        "recovering",
        "complete",
        "maintenance"
      ]
    },
    "autonomy_level": {
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7"]
    },
    "environment": {"type": "string"},
    "objective": {"type": "string"},
    "active_task": {"type": ["string", "null"]},
    "completed_tasks": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "iteration": {"type": "integer", "minimum": 0},
    "last_verified": {"type": ["string", "null"]},
    "next_best_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
