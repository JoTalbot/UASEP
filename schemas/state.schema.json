{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/UASEP/schemas/state.schema.json",
  "title": "UASEP State",
  "type": "object",
  "required": ["protocol", "protocol_version", "project_state"],
  "properties": {
    "protocol": {"const": "UASEP"},
    "protocol_version": {"type": "string"},
    "project_state": {"type": "string"},
    "environment": {"type": "string"},
    "objective": {"type": "string"},
    "active_task": {"type": ["string", "null"]},
    "last_verified": {"type": "string"},
    "next_best_actions": {"type": "array", "items": {"type": "string"}},
    "task_failures": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "description": "Per-task failure counts for cold resume (RUNTIME-005)"
    }
  },
  "additionalProperties": true
}
