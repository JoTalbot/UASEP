{
  "schema": "uasep.repair-action-registry.v1",
  "actions": [
    {
      "name": "retry_workflow",
      "trigger": "ci_failure",
      "enabled": true
    },
    {
      "name": "rebuild_artifact",
      "trigger": "artifact_failure",
      "enabled": true
    },
    {
      "name": "rerun_validation",
      "trigger": "validation_failure",
      "enabled": true
    },
    {
      "name": "halt_release",
      "trigger": "registry_error",
      "enabled": true
    }
  ]
}